PORT=5001
NODE_ENV=development

# MongoDB connection string (MongoDB Atlas or self-hosted)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/kamglobal

# Long random string used to sign admin sessions (required in production)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# First Super Admin, created only when the database has no users. Remove ADMIN_PASSWORD after first start.
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@kamglobalai.com
ADMIN_PASSWORD=

# Allowed website origins, comma separated (leave empty to allow all in development)
CORS_ORIGIN=https://kamglobalai.com,https://www.kamglobalai.com

# Set to 1 when running behind a reverse proxy or load balancer (Render, Railway, Nginx)
TRUST_PROXY=0

# Email notifications (Gmail app password or SMTP account)
EMAIL_USER=
EMAIL_PASS=
HR_NOTIFY_EMAILS=hr@kamglobalai.com,info@kamglobalai.com
